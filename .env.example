# Select ONE mode: friend, server, or realm
BEDROCK_MODE=friend
# Microsoft/Xbox profile identifier for the bot (separate Xbox account from your own)
BOT_PROFILE=KAgentBot
# Friend world mode: an EXACT world name; avoids connecting to a random friend's world.
BEDROCK_WORLD_NAME=My World
# Optional: if multiple friends have worlds with the same name, filter by session hostName.
BEDROCK_WORLD_HOST=
# Server mode: address of dedicated Bedrock server, not necessarily the Windows local-world host.
BEDROCK_HOST=127.0.0.1
BEDROCK_PORT=19132
# Realm mode: realm identifier (bot account must be invited)
BEDROCK_REALM_ID=
# Auth tokens persist here, never commit this directory
BEDROCK_AUTH_DIR=.minecraft-auth
# Only for deliberately unauthenticated test servers; NEVER use for Xbox friend worlds or Realms.
BEDROCK_OFFLINE=false
# Chat output throttling
BOT_CHAT_COOLDOWN_MS=2000
